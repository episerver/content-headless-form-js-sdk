<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="optimizely" value="https://api.nuget.optimizely.com/v3/index.json" />
    <!-- CI builds of the headless form packages (CMS 13 line) are published here. Requires a GitHub PAT with read:packages in the GitHubEpiserverPAT environment variable. -->
    <add key="github.episerver" value="https://nuget.pkg.github.com/episerver/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
        <package pattern="*" />
    </packageSource>
    <packageSource key="optimizely">
	    <package pattern="EPiServer" />
	    <package pattern="EPiServer.*" />
	    <package pattern="Optimizely" />
        <package pattern="Optimizely.*" />
		<package pattern="EPiServer.Forms" />
		<package pattern="EPiServer.Forms.*" />
		<package pattern="Optimizely.Cms.*" />
		<package pattern="EPiServer.AddOns.*" />
	</packageSource>
    <packageSource key="github.episerver">
		<package pattern="Optimizely.Cms.Forms.*" />
	</packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github.episerver>
      <add key="Username" value="Ignored" />
      <add key="ClearTextPassword" value="%GitHubEpiserverPAT%" />
    </github.episerver>
  </packageSourceCredentials>
</configuration>
