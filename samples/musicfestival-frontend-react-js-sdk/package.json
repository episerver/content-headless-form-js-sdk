{
  "name": "music-festival-graphql",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@episerver/forms-sdk": "file:../../src/@episerver/forms-sdk",
    "@tanstack/react-query": "^4.6.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "bootstrap": "^5.2.1",
    "buffer": "^6.0.3",
    "graphql": "^16.6.0",
    "html-react-parser": "^3.0.4",
    "oidc-client": "^1.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-paginate": "^8.2.0",
    "react-router-dom": "^6.4.2",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate": "graphql-codegen",
    "generate:local": "cross-env DOTENV_CONFIG_PATH=./.env npm run generate -- -r dotenv/config",
    "content-definitions:push": "content-definitions push manifest.json -s http://localhost:8082 --authority http://localhost:8082 --client-id cli --client-secret cli --allowed-upgrades major",
    "content-definitions:pull": "content-definitions pull manifest.json -s http://localhost:8082 --authority http://localhost:8082 --client-id cli --client-secret cli"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@graphql-codegen/typescript-react-query": "^8.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
